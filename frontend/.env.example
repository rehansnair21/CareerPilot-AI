# Backend API Base URL (leave unset in development to default to http://localhost:5000)
# In production on Vercel, set this to your deployed backend URL:
VITE_API_URL=https://your-backend-api.onrender.com

# Razorpay Key ID
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

# Google Client ID
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
